{
	"name": "sky-king",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"db:generate": "prisma generate",
		"db:migrate": "prisma migrate deploy",
		"db:seed": "prisma db execute --file prisma/seed.sql",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@eslint/compat": "^2.0.4",
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/postcss": "^4.3.0",
		"@types/bcrypt": "^6.0.0",
		"@types/cookie": "^0.6.0",
		"@types/node": "^24",
		"autoprefixer": "^10.5.0",
		"eslint": "^10.2.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.17.0",
		"globals": "^17.4.0",
		"postcss": "^8.5.15",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.1",
		"prisma": "^7.8.0",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.58.1",
		"vite": "^8.0.7"
	},
	"dependencies": {
		"@prisma/adapter-mariadb": "^7.8.0",
		"@prisma/client": "^7.8.0",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/pdfkit": "^0.17.6",
		"@types/ws": "^8.18.1",
		"bcrypt": "^6.0.0",
		"cookie": "^1.1.1",
		"dotenv": "^17.4.2",
		"jsonwebtoken": "^9.0.3",
		"pdfkit": "^0.18.0",
		"ws": "^8.21.0"
	}
}
