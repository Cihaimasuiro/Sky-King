generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id       Int       @id @default(autoincrement())
  email    String    @unique
  name     String?
  password String
  bookings Booking[]
}

model Airport {
  id          Int      @id @default(autoincrement())
  name        String
  city        String
  country     String
  code        String   @unique
  flightsFrom Flight[] @relation("flightsFrom")
  flightsTo   Flight[] @relation("flightsTo")
}

model Flight {
  id                 Int       @id @default(autoincrement())
  departure          Airport   @relation("flightsFrom", fields: [departureAirportId], references: [id])
  departureAirportId Int
  arrival            Airport   @relation("flightsTo", fields: [arrivalAirportId], references: [id])
  arrivalAirportId   Int
  departureTime      DateTime
  arrivalTime        DateTime
  price              Float
  bookings           Booking[]
}

model Booking {
  id         Int         @id @default(autoincrement())
  user       User        @relation(fields: [userId], references: [id])
  userId     Int
  flight     Flight      @relation(fields: [flightId], references: [id])
  flightId   Int
  passengers Passenger[]
  payment    Payment?
  createdAt  DateTime    @default(now())
}

model Passenger {
  id        Int     @id @default(autoincrement())
  booking   Booking @relation(fields: [bookingId], references: [id])
  bookingId Int
  name      String
  seat      String
}

model Admin {
  id       Int    @id @default(autoincrement())
  email    String @unique
  password String
}

model Payment {
  id            Int      @id @default(autoincrement())
  booking       Booking  @relation(fields: [bookingId], references: [id])
  bookingId     Int      @unique
  amount        Float
  paymentMethod String
  status        String
  createdAt     DateTime @default(now())
}
